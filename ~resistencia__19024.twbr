      <aliases enabled='yes' />
      <column caption='Cambio Global' datatype='real' name='[Calculation_1875534952607744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(&#13;&#10;AVG(IF [year] = 2024 THEN [resistance_percentage] END)&#13;&#10;-&#13;&#10;AVG(IF [year] = 2000 THEN [resistance_percentage] END)&#13;&#10;, 2)' />
      </column>
      <column caption='Cambio global pts' datatype='string' name='[Calculation_1875534952898561]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([Calculation_1875534952607744], 2)) + &quot; pts&quot;' />
      </column>
      <column caption='Media 2000' datatype='real' name='[Calculation_1875534953402370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG(&#13;&#10;    IF [year] = 2000 THEN [resistance_percentage] END&#13;&#10;) }' />
      </column>
      <column caption='Media Año Seleccionado' datatype='real' name='[Calculation_1875534953553923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([resistance_percentage])' />
      </column>
      <column caption='Camvio vs 2000' datatype='real' name='[Calculation_1875534953967621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([resistance_percentage])&#13;&#10;-&#13;&#10;AVG([Calculation_1875534953402370])' />
      </column>
      <column caption='KPI Cambio texto' datatype='string' name='[Calculation_1875534954074118]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;AVG([resistance_percentage]) - AVG([Calculation_1875534953402370]) &gt; 0 THEN&#13;&#10;&#13;&#10;&quot;▲ +&quot; + &#13;&#10;STR(&#13;&#10;ROUND(&#13;&#10;AVG([resistance_percentage]) - AVG([Calculation_1875534953402370])&#13;&#10;, 2)&#13;&#10;) &#13;&#10;+ &quot; pts&quot;&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;AVG([resistance_percentage]) - AVG([Calculation_1875534953402370]) &lt; 0 THEN&#13;&#10;&#13;&#10;&quot;▼ &quot; + &#13;&#10;STR(&#13;&#10;ROUND(&#13;&#10;AVG([resistance_percentage]) - AVG([Calculation_1875534953402370])&#13;&#10;, 2)&#13;&#10;) &#13;&#10;+ &quot; pts&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;&quot;— 0 pts&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Color cambio' datatype='string' name='[Calculation_1875534954323975]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;AVG([resistance_percentage]) - AVG([Calculation_1875534953402370]) &gt; 0 THEN&#13;&#10;&quot;Empeora&quot;&#13;&#10;ELSEIF &#13;&#10;AVG([resistance_percentage]) - AVG([Calculation_1875534953402370]) &lt; 0 THEN&#13;&#10;&quot;Mejora&quot;&#13;&#10;ELSE&#13;&#10;&quot;Igual&quot;&#13;&#10;END' />
      </column>
      <column caption='Media Global Año' datatype='real' name='[Calculation_1875534963294218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [year] : AVG([resistance_percentage]) }' />
      </column>
      <column caption='Comparación vs Media' datatype='string' name='[Calculation_1875534965940236]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([resistance_percentage]) &gt;= AVG([Calculation_1875534963294218]) THEN&#13;&#10;&quot;Por encima de la media&quot;&#13;&#10;ELSE&#13;&#10;&quot;Por debajo de la media&quot;&#13;&#10;END' />
      </column>
      <column caption='Diferencia vs Media' datatype='real' name='[Calculation_1875534966194189]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([resistance_percentage]) - AVG([Calculation_1875534963294218])' />
      </column>
