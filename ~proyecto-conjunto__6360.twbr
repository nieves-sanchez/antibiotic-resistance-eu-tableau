              <calculation class='tableau' formula='{ FIXED [antibiotic_group] :&#13;&#10;    AVG(&#13;&#10;        IF [year] = 2000 THEN &#13;&#10;            [ddd_per_1000_inhabitants_per_day] &#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
