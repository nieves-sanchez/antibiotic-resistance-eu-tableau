      <column caption='Combinación análisis' datatype='string' name='[Calculation_0332371254468608]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Antibiotic group] = &quot;Fluoroquinolonas&quot;&#13;&#10;AND [Bacteria] = &quot;Escherichia coli&quot;&#13;&#10;THEN &quot;Fluoroquinolonas + E.coli&quot;&#13;&#10;&#13;&#10;ELSEIF [Antibiotic group] = &quot;β-lactámicos&quot;&#13;&#10;AND [Bacteria] = &quot;Klebsiella pneumoniae&quot;&#13;&#10;THEN &quot;β-lactámicos + Klebsiella&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='con_res' datatype='real' name='[Calculation_0332371255013377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CORR([Consumption],[Resistance])' />
      </column>
      <column caption='R² Fluoroquinolonas' datatype='real' name='[Calculation_1751016427524096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.670154' />
      </column>
      <column caption='R² β-lactámicos' datatype='real' name='[Calculation_1751016432971777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.656044' />
      </column>
      <column caption='pendiente' datatype='real' name='[Calculation_1751016434118658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='7.3' />
      </column>
