      <column caption='Grupo antibiótico ES' datatype='string' name='[Calculation_1872511641747459]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [antibiotic_group]&#13;&#10;&#13;&#10;WHEN &quot;Aminoglycosides&quot; THEN &quot;Aminoglucósidos&quot;&#13;&#10;WHEN &quot;Fluoroquinolones&quot; THEN &quot;Fluoroquinolonas&quot;&#13;&#10;WHEN &quot;Third-generation cephalosporins&quot; THEN &quot;Cefalosporinas&quot;&#13;&#10;WHEN &quot;Carbapenems&quot; THEN &quot;Carbapenémicos&quot;&#13;&#10;&#13;&#10;ELSE [antibiotic_group]&#13;&#10;&#13;&#10;END' />
