            </column>
            <column caption='KPI ranking final' datatype='integer' name='[Calculation_1182019501006853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([country]) = [Parameters].[Parámetro 1]&#13;&#10;THEN [Calculation_1182019499646979]&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cálculo2' datatype='integer' name='[Calculation_1182019506151432]' role='measure' type='quantitative'>
