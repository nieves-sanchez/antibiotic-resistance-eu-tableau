                <zone h='13713' id='9' type-v2='text' w='98552' x='724' y='1444'>
                  <formatted-text>
                    <run bold='true' fontcolor='#1e3a5f' fontname='Segoe UI Semibold' fontsize='24'>Conclusiones clave: Consumo y Resistencia en Europa (2000–2024)</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold' fontsize='24'>Æ </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
