    <worksheet name='KPI - cambio'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#444c56' fontname='Segoe UI Semibold' fontsize='14'>Variación desde 2000</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='antimicrobial_resistance_2000_2024_processed' name='federated.0vjqnfv13hzy0d11z7zdt03f31id' />
          </datasources>
          <datasource-dependencies datasource='federated.0vjqnfv13hzy0d11z7zdt03f31id'>
            <column caption='Media 2000' datatype='real' name='[Calculation_1872511623200768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : AVG(&#13;&#10;    IF [year] = 2000 THEN [resistance_percentage] END&#13;&#10;) }' />
            </column>
            <column caption='KPI texto' datatype='string' name='[Calculation_1872511623286785]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;AVG([resistance_percentage]) - AVG([Calculation_1872511623200768]) &gt; 0 THEN&#13;&#10;&#13;&#10;&quot;▲ +&quot; + &#13;&#10;STR(&#13;&#10;ROUND(&#13;&#10;AVG([resistance_percentage]) - AVG([Calculation_1872511623200768])&#13;&#10;, 2)&#13;&#10;) &#13;&#10;+ &quot; pts&quot;&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;AVG([resistance_percentage]) - AVG([Calculation_1872511623200768]) &lt; 0 THEN&#13;&#10;&#13;&#10;&quot;▼ &quot; + &#13;&#10;STR(&#13;&#10;ROUND(&#13;&#10;AVG([resistance_percentage]) - AVG([Calculation_1872511623200768])&#13;&#10;, 2)&#13;&#10;) &#13;&#10;+ &quot; pts&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;&quot;— 0 pts&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column-instance column='[year]' derivation='None' name='[none:year:ok]' pivot='key' type='ordinal' />
            <column caption='Resistance Percentage' datatype='real' default-format='*0.00\%' name='[resistance_percentage]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1872511623286785]' derivation='User' name='[usr:Calculation_1872511623286785:nk]' pivot='key' type='nominal' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0vjqnfv13hzy0d11z7zdt03f31id].[none:year:ok]' filter-group='5'>
            <groupfilter function='member' level='[none:year:ok]' member='2007' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.0vjqnfv13hzy0d11z7zdt03f31id].[none:year:ok]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='table'>
            <format attr='background-color' value='#e6e6e6' />
          </style-rule>
        </style>
