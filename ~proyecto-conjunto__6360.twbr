            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p_country' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Bulgaria&quot;'>
              <calculation class='tableau' formula='&quot;Bulgaria&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vjqnfv13hzy0d11z7zdt03f31id'>
            <column caption='Avg Resistance Country-Year' datatype='real' name='[Calculation_1182019499548674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [year], [country] :&#13;&#10;    AVG([resistance_percentage])&#13;&#10;}' />
            </column>
            <column caption='Ranking limpio' datatype='integer' name='[Calculation_1182019499646979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_DENSE( AVG([Calculation_1182019499548674]) , &apos;desc&apos;)'>
                <table-calc ordering-type='Rows' />
