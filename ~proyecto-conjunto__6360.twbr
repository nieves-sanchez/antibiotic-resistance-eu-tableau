            </zone>
            <zone fixed-size='912' h='79907' id='131' is-fixed='true' layout-strategy-id='distribute-evenly' param='horz' type-v2='layout-flow' w='100000' x='0' y='20093'>
              <zone h='79907' id='132' layout-strategy-id='distribute-evenly' param='vert' type-v2='layout-flow' w='50000' x='0' y='20093'>
                <zone forceUpdate='true' h='39630' id='134' type-v2='text' w='49584' x='208' y='20463'>
                  <formatted-text>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1e3a5f' fontname='Segoe UI Semibold' fontsize='20'>Æ        </run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>Æ                 </run>
                    <run bold='true' fontcolor='#1e3a5f' fontname='Segoe UI Semibold' fontsize='20'>Æ      </run>
                    <run bold='true' fontcolor='#1e3a5f' fontname='Segoe UI Semibold' fontsize='22'> 🦠 ¿Qué es una bacteria?</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                                    Las bacterias son microorganismos invisibles al ojo humano.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                                    Algunas son </run>
                    <run bold='true' fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>inofensivas</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'> e incluso necesarias para nuestro organismo.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                                    Otras pueden causar </run>
                    <run bold='true' fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>infecciones</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'> como:</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                                          -Infecciones urinarias</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                                          -Neumonía</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                                          -Infecciones hospitalarias</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>Æ                                                           </run>
                    <run bold='true' fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>Escherichia coli</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>Æ                                                           </run>
                    <run bold='true' fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>Klebsiella pneumoniae</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>Æ                 </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>Æ                                                           </run>
                    <run bold='true' fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>Acinetobacter spp.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#c0c0c0' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='3' />
                    <format attr='margin' value='4' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='39537' id='135' type-v2='text' w='49584' x='208' y='60093'>
                  <formatted-text>
                    <run bold='true' fontcolor='#1e3a5f' fontname='Segoe UI Semibold' fontsize='20'>Æ                     </run>
                    <run bold='true' fontcolor='#1e3a5f' fontname='Segoe UI Semibold' fontsize='22'>   💊 ¿Qué es un antibiótico?</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                                           Un antibiótico es un medicamento que:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>Æ                                                           </run>
                    <run bold='true' fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>-Mata bacterias</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                                           -O impide que se reproduzcan</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                                           Se utilizan para tratar </run>
                    <run bold='true' fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>infecciones bacterianas</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                                           ⚠️ No funcionan contra virus (como la gripe).</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>Æ                                                           </run>
                    <run bold='true' fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>Aminoglucósidos</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>Æ                                                           </run>
                    <run bold='true' fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>Cefalosporinas y Carbapenems (β-lactámicos)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>Æ                                                           </run>
                    <run bold='true' fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>Fluoroquinolonas</run>
                    <run>Æ&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#c0c0c0' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='3' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='79907' id='133' layout-strategy-id='distribute-evenly' param='vert' type-v2='layout-flow' w='50000' x='50000' y='20093'>
                <zone forceUpdate='true' h='40000' id='136' type-v2='text' w='50000' x='50000' y='20093'>
                  <formatted-text>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold' fontsize='22'>Æ             </run>
                    <run bold='true' fontcolor='#1e3a5f' fontname='Segoe UI Semibold' fontsize='22'>⚠️ ¿Qué es la resistencia a los antibióticos?</run>
                    <run>Æ&#10;&#10;&#10;&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                              1️⃣    Administramos un antibiótico</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                              2️⃣    La mayoría de bacterias mueren</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                              3️⃣    Algunas sobreviven</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                              4️⃣    Las que sobreviven se vuelven más fuertes</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                             El antibiótico deja de funcionar y las infecciones se vuelven más difíciles de tratar.</run>
                    <run>Æ&#10;&#10;&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#c0c0c0' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='3' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='39907' id='137' type-v2='text' w='50000' x='50000' y='60093'>
                  <formatted-text>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>Æ                                                        </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1e3a5f' fontname='Segoe UI Semibold' fontsize='22'>                    🔎 ¿Qué queremos analizar?</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                                      Relación entre el consumo de antibióticos y la resistencia bacteriana en Europa (2000–2024).</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                                      ¿Existe relación entre mayor consumo y mayor resistencia? </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                                      ¿Qué bacterias presentan mayor aumento? </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                                      ¿Cómo evoluciona desde 2000 hasta 2024? </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1e3a5f' fontname='Segoe UI Semibold'>                                                      ¿Qué diferencias existen entre países? </run>
                    <run>Æ&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#c0c0c0' />
                    <format attr='border-style' value='solid' />
