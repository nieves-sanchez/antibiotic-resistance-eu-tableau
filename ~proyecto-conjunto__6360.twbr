      <column caption='Ranking limpio' datatype='integer' name='[Calculation_1182019499646979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE( AVG([Calculation_1182019499548674]) , &apos;desc&apos;)'>
